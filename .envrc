# load the dev shell from flake.nix (cached by nix-direnv)
use flake

# repo-local prompt: starship reads this env var, direnv unsets it on exit
export STARSHIP_CONFIG="$PWD/.config/starship.toml"

# ── secrets ────────────────────────────────────────────────────────────────
# This repo consumes the catalyst dotfiles' direnv library rather than
# vendoring it: use_onepassword* are provisioned by home-manager into
# ~/.config/direnv/lib/onepassword.sh, and `op` is a machine-level tool, not
# per-repo toolchain — one op session serves every repo. flake.nix therefore
# ships neither.
#
# Every guard below is `declare -F`: on a machine that hasn't run a dotfiles
# switch the shell still loads, secrets just don't, with a warning. The
# library itself is soft-fail too (op missing, signed out, item not found →
# warn and continue), so a vault item that doesn't exist yet costs you a
# warning rather than a broken `cd`.

# op:// refs in .env.tpl → env vars
if declare -F use_onepassword >/dev/null; then
  use_onepassword .env.tpl
else
  log_error "use_onepassword not provisioned (run dotfiles switch) — secrets NOT loaded"
fi

# secrets, file flavour: some tools only read credentials from a config file.
# use_onepassword_tpl renders the WHOLE template to a gitignored 0600 file
# (default output = template minus .tpl) and exports nothing — you point the
# tool at it yourself, below. It refuses to render to a path that is inside
# this repo and not gitignored, which is why .gitignore's `.npmrc` line is
# load-bearing rather than hygiene.
if declare -F use_onepassword_tpl >/dev/null; then
  use_onepassword_tpl .npmrc.tpl
  # yarn (classic) and npm have no env var for a per-registry token, only a
  # config file; this keeps the rendered one repo-local instead of in ~/.npmrc
  export NPM_CONFIG_USERCONFIG="$PWD/.npmrc"

  # rendering outside the repo works too, for tools with a fixed path —
  # e.g. a kubeconfig assembled from vaulted cluster creds:
  #   use_onepassword_tpl kubeconfig.tpl "$PWD/.secrets/kubeconfig"
  #   export KUBECONFIG="$PWD/.secrets/kubeconfig"
else
  log_error "use_onepassword_tpl not provisioned (run dotfiles switch) — .npmrc NOT rendered"
fi

# secrets, single-file flavour: use_onepassword_file materializes ONE whole
# vault item from a single op:// reference — `op inject` (the two hooks above)
# cannot render these: a 1Password Connect credential, an SSH/TLS keypair,
# anything that is one secret rather than a template of several. Exports
# nothing, same as use_onepassword_tpl — point the tool at the output
# yourself. Same gitignore requirement as .npmrc, hence `.secrets/`.
if declare -F use_onepassword_file >/dev/null; then
  use_onepassword_file "op://dev/git-repo-template/connect-credentials" ".secrets/connect-credentials.json"
  export OP_CONNECT_CREDENTIALS_FILE="$PWD/.secrets/connect-credentials.json"
else
  log_error "use_onepassword_file not provisioned (run dotfiles switch) — connect-credentials.json NOT materialized"
fi

# un-vaulted local overrides (gitignored) — wins over .env.tpl values
dotenv_if_exists .env.local

# ── project deps ───────────────────────────────────────────────────────────
# Auto-install on entry, mtime-guarded so it's a no-op unless a manifest or
# lockfile changed since the last install.
#
# Each block is additionally guarded on the MANIFEST existing, not just the
# install dir. This is a template: a repo created from it may have no backend
# or no frontend, and an unguarded `cd backend && uv sync` would fail the
# whole direnv load on a directory that was never there.
#
# Prefer no side effects on `cd`? Swap the install commands for an
# `echo "deps stale — run uv sync / yarn install"`.

if [ -f backend/pyproject.toml ] &&
  { [ ! -d backend/.venv ] ||
    [ backend/pyproject.toml -nt backend/.venv ] ||
    [ backend/uv.lock -nt backend/.venv ]; }; then
  (cd backend && uv sync) && touch backend/.venv
fi

if [ -f frontend/package.json ] &&
  { [ ! -d frontend/node_modules ] ||
    [ frontend/package.json -nt frontend/node_modules ] ||
    [ frontend/yarn.lock -nt frontend/node_modules ]; }; then
  (cd frontend && yarn install) && touch frontend/node_modules
fi
